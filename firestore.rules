rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /communityPosts/{postId} {
      // Communal space: anyone can read shared photos, designs, and inventory
      allow read: if true;
      // Authenticated makers can publish posts with their authorUid
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      // Authors can update or delete their own posts
      allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /hardwareCatalog/{itemId} {
      // Hardware catalog is globally readable
      allow read: if true;
      // Authenticated users or initial seed loader can write/update items
      allow write: if isSignedIn();
    }

    match /showcaseProjects/{projectId} {
      // Community published projects are globally readable
      allow read: if true;
      // Authenticated users can publish with their authorUid
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      // Authors can update everything; authenticated community members can like/comment
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'comments'])
      );
      // Only author can delete their project
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}

